@database :memory:

# vc_merge_basic.sqltest
#
# Merge driver through the scalar surface: a clean fast-path merge, a
# conflicting merge with `dolt_merge_status`, and resolution unblocking the
# merge commit.

test vc-merge-fast-path-takes-theirs {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base'), (2, 'keep');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'feat' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    SELECT dolt_merge('feature');
    SELECT count(*) FROM dolt_conflicts;
}
expect pattern {
    (?m)^Ada\nada@example\.com\n1\n[0-9a-f]{40}\nfeature\nfeature\n1\n[0-9a-f]{40}\nmain\n[0-9a-f]{40}\n0$
}

test vc-merge-conflict-refuses-commit {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base'), (2, 'keep');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'theirs' WHERE id = 1;
    INSERT INTO t VALUES (3, 'feat');
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 'ours' WHERE id = 1;
    INSERT INTO t VALUES (4, 'main');
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT count(*) FROM dolt_conflicts;
    SELECT dolt_commit('blocked');
}
expect error {
    cannot commit: unresolved merge conflicts
}

test vc-merge-resolve-unblocks-commit {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base'), (2, 'keep');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'theirs' WHERE id = 1;
    INSERT INTO t VALUES (3, 'feat');
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 'ours' WHERE id = 1;
    INSERT INTO t VALUES (4, 'main');
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT table_name, conflict_type FROM dolt_conflicts;
    SELECT table_name, state FROM dolt_merge_status;
    SELECT dolt_conflicts_resolve('--theirs', 't', 1);
    SELECT count(*) FROM dolt_conflicts;
    SELECT dolt_commit('merged');
}
expect pattern {
    (?m)^Ada\nada@example\.com\n1\n[0-9a-f]{40}\nfeature\nfeature\n1\n[0-9a-f]{40}\nmain\n1\n[0-9a-f]{40}\nmerge conflict: 1 conflicting rows in 1 tables\nt\|rows\nt\|conflicted\n0\n0\n[0-9a-f]{40}$
}

test vc-merge-invalid-resolve-side {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'theirs' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 'ours' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT dolt_conflicts_resolve('--mine', 't', 1);
}
expect error {
    invalid resolve side: '--mine' \(want '--ours' or '--theirs'\)
}

test vc-merge-schema-conflict-reports-and-status {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (a INTEGER PRIMARY KEY, b TEXT);
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    DROP TABLE t;
    CREATE TABLE t (b INTEGER PRIMARY KEY, a TEXT);
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    DROP TABLE t;
    CREATE TABLE t (c INTEGER PRIMARY KEY, b TEXT);
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT table_name, schema_conflict, state FROM dolt_merge_status;
}
expect pattern {
    (?m)^Ada\nada@example\.com\n1\n[0-9a-f]{40}\nfeature\nfeature\n1\n[0-9a-f]{40}\nmain\n1\n[0-9a-f]{40}\nschema conflict in table: t \(primary key changed on both sides\)\nt\|1\|conflicted$
}

test vc-merge-second-merge-refused {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'theirs' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 'ours' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT dolt_merge('feature');
}
expect error {
    merge already in progress
}