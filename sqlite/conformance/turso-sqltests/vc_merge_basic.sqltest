@database :memory:

# vc_merge_basic.sqltest
#
# Merge driver through the scalar surface: a clean fast-path merge, a
# conflicting merge with `dolt_merge_status`, and resolution unblocking the
# merge commit.

test vc-merge-fast-path-takes-theirs {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base'), (2, 'keep');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'feat' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    SELECT dolt_merge('feature');
    SELECT count(*) FROM dolt_conflicts;
}
expect pattern {
    (?m)^Ada\nada@example\.com\n1\n[0-9a-f]{40}\nfeature\nfeature\n1\n[0-9a-f]{40}\nmain\n[0-9a-f]{40}\n0$
}

test vc-merge-conflict-refuses-commit {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base'), (2, 'keep');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'theirs' WHERE id = 1;
    INSERT INTO t VALUES (3, 'feat');
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 'ours' WHERE id = 1;
    INSERT INTO t VALUES (4, 'main');
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT count(*) FROM dolt_conflicts;
    SELECT dolt_commit('blocked');
}
expect error {
    cannot commit: unresolved merge conflicts
}

test vc-merge-resolve-unblocks-commit {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base'), (2, 'keep');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'theirs' WHERE id = 1;
    INSERT INTO t VALUES (3, 'feat');
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 'ours' WHERE id = 1;
    INSERT INTO t VALUES (4, 'main');
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT table_name, conflict_type FROM dolt_conflicts;
    SELECT table_name, state FROM dolt_merge_status;
    SELECT dolt_conflicts_resolve('--theirs', 't', 1);
    SELECT count(*) FROM dolt_conflicts;
    SELECT dolt_commit('merged');
}
expect pattern {
    (?m)^Ada\nada@example\.com\n1\n[0-9a-f]{40}\nfeature\nfeature\n1\n[0-9a-f]{40}\nmain\n1\n[0-9a-f]{40}\nmerge conflict: 1 conflicting rows in 1 tables\nt\|rows\nt\|conflicted\n0\n0\n[0-9a-f]{40}$
}

test vc-merge-invalid-resolve-side {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'theirs' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 'ours' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT dolt_conflicts_resolve('--mine', 't', 1);
}
expect error {
    invalid resolve side: '--mine' \(want '--ours' or '--theirs'\)
}

test vc-merge-schema-conflict-reports-and-status {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (a INTEGER PRIMARY KEY, b TEXT);
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    DROP TABLE t;
    CREATE TABLE t (b INTEGER PRIMARY KEY, a TEXT);
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    DROP TABLE t;
    CREATE TABLE t (c INTEGER PRIMARY KEY, b TEXT);
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT table_name, schema_conflict, state FROM dolt_merge_status;
}
expect pattern {
    (?m)^Ada\nada@example\.com\n1\n[0-9a-f]{40}\nfeature\nfeature\n1\n[0-9a-f]{40}\nmain\n1\n[0-9a-f]{40}\nschema conflict in table: t \(primary key changed on both sides\)\nt\|1\|conflicted$
}

test vc-merge-second-merge-refused {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'theirs' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 'ours' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT dolt_merge('feature');
}
expect error {
    merge already in progress
}
test vc-merge-base-returns-common-ancestor {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_merge_base('main', 'feature') = dolt_hashof('main');
    SELECT dolt_merge_base('main', 'HEAD') = dolt_hashof('main');
}
expect pattern {
    (?m)^Ada\nada@example\.com\n1\n[0-9a-f]{40}\nfeature\n1\n1$
}

test vc-merge-base-unknown-branch-errors {
    SELECT dolt_merge_base('nope', 'main');
}
expect error {
    branch not found: nope
}

test vc-merge-status-lifecycle-after-resolve-and-commit {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
    INSERT INTO t VALUES (1, 'base');
    SELECT dolt_add('t');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('feature');
    SELECT dolt_checkout('feature');
    UPDATE t SET v = 'theirs' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('feature work');
    SELECT dolt_checkout('main');
    UPDATE t SET v = 'ours' WHERE id = 1;
    SELECT dolt_add('t');
    SELECT dolt_commit('main work');
    SELECT dolt_merge('feature');
    SELECT table_name, rows_conflicted, state FROM dolt_merge_status;
    SELECT dolt_conflicts_resolve('--theirs', 't', 1);
    SELECT table_name, rows_merged, state FROM dolt_merge_status;
    SELECT dolt_add('t');
    SELECT dolt_commit('merged');
    SELECT count(*) FROM dolt_merge_status;
    SELECT v FROM t;
}
expect pattern {
    (?m)^Ada\nada@example\.com\n1\n[0-9a-f]{40}\nfeature\nfeature\n1\n[0-9a-f]{40}\nmain\n1\n[0-9a-f]{40}\nmerge conflict: 1 conflicting rows in 1 tables\nt\|1\|conflicted\n0\nt\|1\|clean\n1\n[0-9a-f]{40}\n0\ntheirs$
}

test vc-merge-multi-table-spreads-changes {
    SELECT dolt_config('user.name', 'Ada');
    SELECT dolt_config('user.email', 'ada@example.com');
    CREATE TABLE a (id INTEGER PRIMARY KEY, v TEXT);
    CREATE TABLE b (id INTEGER PRIMARY KEY, w TEXT);
    CREATE TABLE c (id INTEGER PRIMARY KEY, x TEXT);
    INSERT INTO a VALUES (1, 'a1');
    INSERT INTO b VALUES (1, 'b1');
    INSERT INTO c VALUES (1, 'c1');
    SELECT dolt_add('-A');
    SELECT dolt_commit('seed');
    SELECT dolt_branch('dev');
    SELECT dolt_checkout('dev');
    INSERT INTO a VALUES (2, 'a2-dev');
    UPDATE b SET w = 'b1-dev';
    ALTER TABLE c ADD COLUMN y TEXT;
    SELECT dolt_add('-A');
    SELECT dolt_commit('dev');
    SELECT dolt_checkout('main');
    INSERT INTO a VALUES (3, 'a3-main');
    SELECT dolt_add('-A');
    SELECT dolt_commit('main');
    SELECT dolt_merge('dev');
    SELECT 'A', group_concat(id || ':' || v) FROM (SELECT id, v FROM a ORDER BY id);
    SELECT 'B', w FROM b;
    SELECT 'C', count(*) FROM pragma_table_info('c');
    SELECT table_name FROM dolt_diff_stat('HEAD~1', 'HEAD') ORDER BY table_name;
}
expect pattern {
    (?m)^Ada\nada@example\.com\n3\n[0-9a-f]{40}\ndev\ndev\n3\n[0-9a-f]{40}\nmain\n2\n[0-9a-f]{40}\n[0-9a-f]{40}\nA\|1:a1,2:a2-dev,3:a3-main\nB\|b1-dev\nC\|3\na\nb\nc$
}
